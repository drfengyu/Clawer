<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Microsoft YaHei', sans-serif; background: #f5f6f8; color: #333; font-size: 14px; }
    .admin-header { display: flex; align-items: center; gap: 16px; padding: 14px 24px; background: #fff; border-bottom: 1px solid #eee; position: sticky; top: 0; z-index: 10; flex-wrap: wrap; }
    .admin-header h1 { font-size: 18px; color: #e7a519; margin-right: auto; }
    .admin-header .ctrl { display: flex; align-items: center; gap: 8px; }
    .btn { padding: 7px 14px; border: 1px solid #e7a519; background: #e7a519; color: #fff; border-radius: 6px; cursor: pointer; font-size: 13px; }
    .btn:hover { background: #d6940f; }
    .btn.ghost { background: #fff; color: #e7a519; }
    .btn.ghost:hover { background: #fff8ec; }
    .switch { display: inline-flex; align-items: center; gap: 6px; color: #555; cursor: pointer; user-select: none; }
    .switch input { width: 16px; height: 16px; accent-color: #e7a519; }
    .auto-note { color: #999; font-size: 12px; }

    .tabs { display: flex; gap: 6px; padding: 12px 24px 0; flex-wrap: wrap; background: #f5f6f8; }
    .tab { padding: 8px 14px; border-radius: 8px 8px 0 0; border: 1px solid #e3e3e3; border-bottom: none; background: #ececec; cursor: pointer; font-size: 13px; color: #555; transition: all .15s; }
    .tab:hover { background: #f3f3f3; }
    .tab.active { background: #fff; color: #e7a519; font-weight: 600; border-color: #e7a519; }
    .tab .count { display: inline-block; margin-left: 6px; padding: 0 7px; border-radius: 10px; background: #ddd; color: #666; font-size: 11px; }
    .tab.active .count { background: #fff3cd; color: #856404; }

    .panel { background: #fff; margin: 0 24px 24px; border: 1px solid #eee; border-radius: 0 8px 8px 8px; min-height: 200px; }
    .toolbar { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-bottom: 1px solid #f0f0f0; flex-wrap: wrap; }
    .toolbar input.search { flex: 1; min-width: 200px; padding: 8px 12px; border: 1px solid #ddd; border-radius: 6px; font-size: 13px; }
    .toolbar input.search:focus { outline: none; border-color: #e7a519; }
    .toolbar .meta { color: #888; font-size: 12px; white-space: nowrap; }

    .table-wrap { overflow-x: auto; }
    table { border-collapse: collapse; width: 100%; font-size: 13px; }
    th, td { padding: 8px 12px; border-bottom: 1px solid #f0f0f0; text-align: left; vertical-align: top; white-space: nowrap; }
    th { background: #fafafa; color: #666; font-weight: 600; position: sticky; top: 0; cursor: pointer; user-select: none; }
    th:hover { color: #e7a519; }
    th .arrow { color: #e7a519; font-size: 11px; margin-left: 4px; }
    tbody tr:hover { background: #fffaf0; }
    td .cell { max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: inline-block; vertical-align: bottom; cursor: pointer; }
    td .cell.expanded { white-space: normal; word-break: break-all; max-width: 480px; }
    td.null { color: #bbb; font-style: italic; }

    .pager { display: flex; align-items: center; justify-content: center; gap: 12px; padding: 14px; }
    .pager button { padding: 6px 14px; border: 1px solid #ddd; background: #fff; border-radius: 6px; cursor: pointer; font-size: 13px; }
    .pager button:disabled { opacity: .45; cursor: not-allowed; }
    .pager .info { color: #666; font-size: 13px; }

    .state { padding: 48px; text-align: center; color: #999; }
    .state.error { color: #e74c3c; }
  </style>
</head>
<body>
  <div class="admin-header">
    <h1>🗄️ 数据库后台</h1>
    <div class="ctrl">
      <button class="btn" id="refreshBtn">🔄 刷新</button>
      <label class="switch"><input type="checkbox" id="autoRefresh"> 自动刷新</label>
      <span class="auto-note">每 5 秒</span>
    </div>
  </div>

  <div class="tabs" id="tabs"></div>

  <div class="panel">
    <div class="toolbar">
      <input type="text" class="search" id="searchInput" placeholder="搜索当前表（跨所有列）…">
      <span class="meta" id="tableMeta"></span>
    </div>
    <div class="table-wrap">
      <div class="state" id="state">加载中…</div>
      <table id="dataTable" style="display:none">
        <thead id="thead"></thead>
        <tbody id="tbody"></tbody>
      </table>
    </div>
    <div class="pager" id="pager" style="display:none">
      <button id="prevBtn">← 上一页</button>
      <span class="info" id="pageInfo"></span>
      <button id="nextBtn">下一页 →</button>
    </div>
  </div>

  <script src="/js/admin.js"></script>
</body>
</html>
