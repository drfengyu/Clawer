<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .gallery-header {
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
      padding: 24px 32px; color: #fff;
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 16px;
    }
    .gallery-header h1 { font-size: 24px; margin: 0; }
    .main-nav { display: flex; gap: 6px; flex-wrap: wrap; }
    .main-nav .nav-link {
      padding: 7px 16px; border-radius: 8px; color: rgba(255,255,255,.8);
      text-decoration: none; font-size: 14px; transition: all .2s;
    }
    .main-nav .nav-link:hover { background: rgba(255,255,255,.15); color: #fff; }
    .main-nav .nav-link.active { background: #e7a519; color: #fff; }
    .count-badge { background: #e7a519; color: #fff; padding: 4px 12px; border-radius: 20px; font-size: 13px; }
    .anime-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 20px; padding: 24px 32px;
    }
    .anime-card {
      background: #fff; border-radius: 10px; overflow: hidden; cursor: pointer;
      box-shadow: 0 2px 8px rgba(0,0,0,.08); transition: transform .2s, box-shadow .2s;
      text-decoration: none; color: inherit; display: block;
    }
    .anime-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,.15); }
    .anime-card .cover-wrap { position: relative; width: 100%; padding-top: 140%; background: #e8e8e8; overflow: hidden; }
    .anime-card .cover-wrap img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .3s; background: #e8e8e8; }
    .anime-card:hover .cover-wrap img { transform: scale(1.05); }
    .anime-card .cover-wrap .no-cover { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #aaa; font-size: 13px; text-align: center; padding: 20px; }
    .anime-card .score-badge { position: absolute; top: 8px; right: 8px; background: rgba(0,0,0,.7); color: #ffb300; padding: 2px 8px; border-radius: 12px; font-size: 12px; font-weight: bold; }
    .anime-card .status-badge { position: absolute; bottom: 0; left: 0; padding: 5px 10px; background: linear-gradient(transparent, rgba(0,0,0,.75)); color: #fff; font-size: 12px; border-radius: 0 0 0 10px; }
    .anime-card .card-info { padding: 10px 12px 12px; }
    .anime-card .card-title { font-size: 14px; font-weight: 600; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; color: #222; }
    .empty-state { grid-column: 1 / -1; text-align: center; padding: 80px 20px; color: #999; }
    @media (max-width: 640px) {
      .anime-grid { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; padding: 12px; }
      .gallery-header { padding: 16px; }
    }
  </style>
</head>
<body>
  <header class="gallery-header">
    <div>
      <h1><%= categoryName %></h1>
      <span style="opacity:.7;font-size:13px">分区动漫</span>
    </div>
    <nav class="main-nav">
      <a href="/gallery" class="nav-link">每日更新</a>
      <% (categories || []).forEach(cat => { %>
        <a href="/category/<%= encodeURIComponent(cat) %>" class="nav-link <%= cat === categoryName ? 'active' : '' %>"><%= cat %></a>
      <% }); %>
    </nav>
    <div><span class="count-badge"><%= animes.length %> 部</span></div>
  </header>

  <div class="anime-grid">
    <% if (animes.length === 0) { %>
      <div class="empty-state"><p style="font-size:48px">📭</p><p>该分区暂无内容</p></div>
    <% } else { %>
      <% animes.forEach(a => { %>
        <a class="anime-card" href="/anime/<%= a.id %>">
          <div class="cover-wrap">
            <% if (a.cover) { %>
              <img src="<%= a.cover %>" alt="<%= a.title %>" loading="lazy" referrerpolicy="no-referrer"
                   onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
              <div class="no-cover" style="display:none"><%= a.title.slice(0,8) %></div>
            <% } else { %>
              <div class="no-cover"><%= a.title.slice(0,8) %></div>
            <% } %>
            <span class="score-badge"><%= a.score.toFixed(1) %></span>
            <span class="status-badge"><%= a.status %></span>
          </div>
          <div class="card-info">
            <div class="card-title"><%= a.title %></div>
          </div>
        </a>
      <% }); %>
    <% } %>
  </div>
</body>
</html>
