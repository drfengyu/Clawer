<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Microsoft YaHei', sans-serif; background: #f5f6f8; color: #333; font-size: 14px; }
    .admin-header { display: flex; align-items: center; gap: 16px; padding: 14px 24px; background: #fff; border-bottom: 1px solid #eee; position: sticky; top: 0; z-index: 10; flex-wrap: wrap; }
    .admin-header h1 { font-size: 18px; color: #e7a519; margin-right: auto; }
    .btn { padding: 7px 14px; border: 1px solid #e7a519; background: #e7a519; color: #fff; border-radius: 6px; cursor: pointer; font-size: 13px; text-decoration: none; display: inline-block; }
    .btn:hover { background: #d6940f; }
    .btn.ghost { background: #fff; color: #e7a519; }
    .btn.ghost:hover { background: #fff8ec; }

    .layout { display: flex; gap: 16px; padding: 16px 24px 32px; align-items: flex-start; }
    /* 左侧接口目录 */
    .catalog { width: 280px; flex-shrink: 0; background: #fff; border: 1px solid #eee; border-radius: 8px; overflow: hidden; }
    .catalog .group-title { padding: 10px 14px; background: #fafafa; color: #888; font-size: 12px; font-weight: 600; border-bottom: 1px solid #f0f0f0; }
    .catalog .api-item { padding: 9px 14px; border-bottom: 1px solid #f5f5f5; cursor: pointer; transition: background .12s; }
    .catalog .api-item:hover { background: #fffaf0; }
    .catalog .api-item .m { display: inline-block; min-width: 46px; font-size: 11px; font-weight: 700; padding: 1px 6px; border-radius: 4px; margin-right: 6px; text-align: center; color: #fff; }
    .m.GET { background: #2e9e5b; } .m.POST { background: #e7a519; } .m.PUT { background: #3477c9; } .m.DELETE { background: #d9534f; }
    .catalog .api-item .p { font-family: ui-monospace, Consolas, monospace; font-size: 12px; color: #444; word-break: break-all; }
    .catalog .api-item .d { color: #999; font-size: 11px; margin-top: 2px; }

    /* 右侧请求/响应 */
    .console { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 14px; }
    .card { background: #fff; border: 1px solid #eee; border-radius: 8px; padding: 16px; }
    .req-line { display: flex; gap: 8px; }
    .req-line select { padding: 9px 10px; border: 1px solid #ddd; border-radius: 6px; font-size: 13px; font-weight: 700; }
    .req-line input { flex: 1; min-width: 0; padding: 9px 12px; border: 1px solid #ddd; border-radius: 6px; font-size: 13px; font-family: ui-monospace, Consolas, monospace; }
    .req-line input:focus, textarea:focus, select:focus { outline: none; border-color: #e7a519; }
    .field { margin-top: 12px; }
    .field label { display: block; color: #777; font-size: 12px; margin-bottom: 5px; }
    textarea { width: 100%; min-height: 90px; padding: 10px 12px; border: 1px solid #ddd; border-radius: 6px; font-size: 13px; font-family: ui-monospace, Consolas, monospace; resize: vertical; }
    .actions { margin-top: 14px; display: flex; align-items: center; gap: 12px; }
    .hint { color: #aaa; font-size: 12px; }

    .resp-head { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; flex-wrap: wrap; }
    .resp-head .title { font-weight: 600; color: #555; margin-right: auto; }
    .badge { padding: 3px 10px; border-radius: 12px; font-size: 12px; font-weight: 700; color: #fff; }
    .badge.s2 { background: #2e9e5b; } .badge.s4 { background: #e7a519; } .badge.s5 { background: #d9534f; } .badge.err { background: #888; }
    .badge.time { background: #eef1f4; color: #667; }
    .toggle-raw { font-size: 12px; color: #e7a519; cursor: pointer; user-select: none; }
    pre.resp { background: #1e1e22; color: #e6e6e6; padding: 14px; border-radius: 6px; overflow: auto; max-height: 60vh; font-size: 12.5px; line-height: 1.5; white-space: pre-wrap; word-break: break-all; }
    pre.resp .truncated { color: #e7a519; }
    .placeholder { color: #aaa; }
    @media (max-width: 820px) { .layout { flex-direction: column; } .catalog { width: 100%; } }
  </style>
</head>
<body>
  <div class="admin-header">
    <h1>🔧 API 在线调试</h1>
    <a class="btn ghost" href="/admin">🗄️ 数据库后台</a>
    <a class="btn ghost" href="/gallery">🏠 画廊</a>
  </div>

  <div class="layout">
    <aside class="catalog" id="catalog"></aside>

    <section class="console">
      <div class="card">
        <div class="req-line">
          <select id="method">
            <option>GET</option><option>POST</option><option>PUT</option><option>DELETE</option>
          </select>
          <input type="text" id="url" placeholder="/api/anime/daily" value="/api/anime/daily">
          <button class="btn" id="sendBtn">发送 ▶</button>
        </div>
        <div class="field">
          <label>请求头 Headers（JSON，可留空；POST/PUT 默认带 Content-Type: application/json）</label>
          <textarea id="headers" placeholder='{ "Content-Type": "application/json" }' style="min-height:60px"></textarea>
        </div>
        <div class="field">
          <label>请求体 Body（JSON，仅 POST/PUT 生效）</label>
          <textarea id="body" placeholder='{ "siteUrl": "https://m.tiantiandongman.com/" }'></textarea>
        </div>
        <div class="actions">
          <span class="hint">提示：URL 中的 <code>:id</code>/<code>:epId</code> 等占位符请替换为实际值</span>
        </div>
      </div>

      <div class="card">
        <div class="resp-head">
          <span class="title">响应</span>
          <span id="statusBadge"></span>
          <span id="timeBadge"></span>
          <span class="toggle-raw" id="toggleRaw" style="display:none">切换原始/格式化</span>
        </div>
        <pre class="resp" id="respBody"><span class="placeholder">点击左侧接口填充，或直接填写后点「发送」。</span></pre>
      </div>
    </section>
  </div>

  <script src="/js/apiDebug.js"></script>
</body>
</html>
