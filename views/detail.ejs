<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .detail-container { max-width: 1100px; margin: 0 auto; padding: 24px; }
    .detail-hero { display: flex; gap: 24px; margin-bottom: 32px; }
    .detail-cover { flex-shrink: 0; width: 240px; }
    .detail-cover img { width: 100%; border-radius: 12px; box-shadow: 0 4px 16px rgba(0,0,0,.2); aspect-ratio: 3/4; object-fit: cover; background: #eee; }
    .detail-info { flex: 1; min-width: 0; }
    .detail-info h1 { font-size: 24px; margin: 0 0 12px; line-height: 1.3; }
    .detail-meta { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 12px; font-size: 14px; color: #666; }
    .detail-meta .tag { padding: 3px 10px; border-radius: 14px; font-size: 12px; }
    .tag-score { background: #fff3cd; color: #856404; }
    .tag-status { background: #d4edda; color: #155724; }
    .tag-category { background: #e2e3f1; color: #303fa0; }
    .detail-desc { font-size: 13px; color: #555; line-height: 1.7; max-height: 100px; overflow: hidden; transition: max-height .3s; position: relative; }
    .detail-desc.expanded { max-height: 1000px; }
    .detail-desc-toggle { color: #e7a519; cursor: pointer; font-size: 13px; margin-top: 4px; display: inline-block; }
    .detail-meta-table { margin-top: 12px; font-size: 13px; color: #555; }
    .meta-row { display: flex; padding: 3px 0; }
    .meta-label { flex-shrink: 0; width: 72px; color: #888; }
    .meta-value { flex: 1; color: #333; }
    .episode-section { margin-top: 24px; }
    .line-tabs { display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; }
    .line-tab { padding: 8px 18px; border-radius: 8px 8px 0 0; border: 1px solid #ddd; border-bottom: none; cursor: pointer; font-size: 14px; background: #f5f5f5; transition: all .2s; }
    .line-tab.active { background: #fff; border-color: #e7a519; color: #e7a519; font-weight: 600; }
    .ep-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(80px, 1fr)); gap: 8px; padding: 16px; background: #fff; border: 1px solid #eee; border-radius: 0 8px 8px 8px; min-height: 60px; }
    .ep-link { display: flex; align-items: center; justify-content: center; padding: 8px 4px; border-radius: 6px; border: 1px solid #e0e0e0; text-decoration: none; color: #333; font-size: 13px; transition: all .15s; text-align: center; }
    .ep-link:hover { background: #e7a519; color: #fff; border-color: #e7a519; }
    .ep-link.latest { background: #fff3cd; border-color: #e7a519; color: #856404; font-weight: 600; position: relative; }
    .ep-link.latest::after { content: 'NEW'; position: absolute; top: -6px; right: -6px; background: #e74c3c; color: #fff; font-size: 10px; padding: 1px 5px; border-radius: 8px; }
    .ep-link.played { background: #f0f0f0; color: #999; }
    .btn-back { display: inline-flex; align-items: center; gap: 6px; color: #555; text-decoration: none; font-size: 14px; margin-bottom: 16px; }
    .btn-back:hover { color: #e7a519; }
    @media (max-width: 640px) {
      .detail-hero { flex-direction: column; }
      .detail-cover { width: 160px; margin: 0 auto; }
    }
  </style>
</head>
<body>
  <div class="detail-container">
    <a href="/gallery" class="btn-back">&#8592; 返回画廊</a>

    <div class="detail-hero">
      <div class="detail-cover">
        <img src="<%= anime.cover %>" alt="<%= anime.title %>" onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22240%22 height=%22320%22><rect fill=%22%23ddd%22 width=%22240%22 height=%22320%22/><text fill=%22%23999%22 x=%22120%22 y=%22160%22 text-anchor=%22middle%22 font-size=%2216%22>暂无封面</text></svg>'">
      </div>
      <div class="detail-info">
        <h1><%= anime.title %></h1>
        <div class="detail-meta">
          <span class="tag tag-score">⭐ <%= anime.score.toFixed(1) %> 分</span>
          <span class="tag tag-status"><%= anime.status %></span>
          <% (anime.categories || []).forEach(c => { %>
            <span class="tag tag-category"><%= c.name %></span>
          <% }); %>
          <% if (anime.update_date) { %>
            <span style="color:#999">更新于 <%= anime.update_date %></span>
          <% } %>
        </div>
        <% if (anime.description) { %>
          <div class="detail-desc" id="desc"><%= anime.description %></div>
          <span class="detail-desc-toggle" id="descToggle" onclick="toggleDesc()">展开全部 ▼</span>
        <% } %>
        <% if (meta && Object.keys(meta).length > 0) { %>
          <div class="detail-meta-table">
            <% if (meta.name) { %><div class="meta-row"><span class="meta-label">名称</span><span class="meta-value"><%= meta.name %></span></div><% } %>
            <% if (meta.cast) { %><div class="meta-row"><span class="meta-label">主演</span><span class="meta-value"><%= meta.cast %></span></div><% } %>
            <% if (meta.genre) { %><div class="meta-row"><span class="meta-label">类型</span><span class="meta-value"><%= meta.genre %></span></div><% } %>
            <% if (meta.area) { %><div class="meta-row"><span class="meta-label">国家/地区</span><span class="meta-value"><%= meta.area %></span></div><% } %>
            <% if (meta.language) { %><div class="meta-row"><span class="meta-label">语言</span><span class="meta-value"><%= meta.language %></span></div><% } %>
            <% if (meta.premiere) { %><div class="meta-row"><span class="meta-label">首播</span><span class="meta-value"><%= meta.premiere %></span></div><% } %>
          </div>
        <% } %>
      </div>
    </div>

    <div class="episode-section">
      <% const lineKeys = Object.keys(lines); %>
      <div class="line-tabs" id="lineTabs">
        <% lineKeys.forEach((name, i) => { %>
          <button class="line-tab <%= i === 0 ? 'active' : '' %>" data-line="<%= name %>"><%= name %></button>
        <% }); %>
      </div>
      <% lineKeys.forEach((name, i) => { %>
        <div class="ep-grid line-panel" data-line="<%= name %>" style="<%= i === 0 ? '' : 'display:none' %>">
          <% (lines[name] || []).forEach(ep => { %>
            <a class="ep-link<%= (latestEp && ep.ep_number === latestEp) ? ' latest' : '' %>"
               href="/play/<%= ep.id %>"
               id="ep-<%= ep.ep_number %>"><%= ep.label %></a>
          <% }); %>
        </div>
      <% }); %>
    </div>
  </div>

  <script src="/js/detail.js"></script>
</body>
</html>
