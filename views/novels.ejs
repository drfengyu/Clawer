<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .gallery-header {
      background: linear-gradient(135deg, #2c3e50 0%, #34495e 50%, #1a252f 100%);
      padding: 24px 32px; color: #fff;
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 16px;
    }
    .gallery-header h1 { font-size: 24px; margin: 0; }
    .main-nav { display: flex; gap: 6px; flex-wrap: wrap; }
    .main-nav .nav-link {
      padding: 7px 16px; border-radius: 8px; color: rgba(255,255,255,.8);
      text-decoration: none; font-size: 14px; transition: all .2s;
    }
    .main-nav .nav-link:hover { background: rgba(255,255,255,.15); color: #fff; }
    .main-nav .nav-link.active { background: #3498db; color: #fff; }

    .crawl-bar {
      padding: 16px 32px; background: #ecf0f1; border-bottom: 1px solid #bdc3c7;
      display: flex; gap: 10px; align-items: center; flex-wrap: wrap;
    }
    .crawl-bar input {
      flex: 1; min-width: 240px; padding: 10px 14px;
      border: 1px solid #bdc3c7; border-radius: 8px; font-size: 14px;
    }
    .crawl-bar button {
      padding: 10px 20px; background: #3498db; color: #fff;
      border: none; border-radius: 8px; cursor: pointer;
      font-size: 14px; font-weight: 600; white-space: nowrap;
    }
    .crawl-bar button:hover { background: #2980b9; }
    .crawl-bar button:disabled { opacity: .6; cursor: not-allowed; }
    .crawl-bar .crawl-msg { font-size: 13px; color: #666; }

    .novel-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 20px; padding: 24px 32px;
    }
    .novel-card {
      background: #fff; border-radius: 8px; overflow: hidden; cursor: pointer;
      box-shadow: 0 2px 8px rgba(0,0,0,.08); transition: transform .2s, box-shadow .2s;
      text-decoration: none; color: inherit; display: block;
    }
    .novel-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,.15); }
    .novel-card .cover-wrap {
      position: relative; width: 100%; padding-top: 140%;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); overflow: hidden;
    }
    .novel-card .cover-wrap img {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;
      transition: transform .3s;
    }
    .novel-card:hover .cover-wrap img { transform: scale(1.05); }
    .novel-card .cover-wrap .no-cover {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      display: flex; align-items: center; justify-content: center; flex-direction: column;
      color: rgba(255,255,255,.9); font-size: 13px; text-align: center; padding: 16px;
      font-weight: 500;
    }
    .novel-card .cover-wrap .no-cover::before {
      content: "📖"; font-size: 32px; margin-bottom: 8px;
    }
    .novel-card .status-badge {
      position: absolute; top: 8px; right: 8px;
      background: rgba(0,0,0,.7); color: #fff;
      padding: 3px 8px; border-radius: 12px; font-size: 11px;
    }
    .novel-card .category-badge {
      position: absolute; bottom: 8px; left: 8px;
      background: rgba(52,152,219,.9); color: #fff;
      padding: 3px 8px; border-radius: 12px; font-size: 11px;
    }
    .novel-card .card-info { padding: 10px 12px 12px; }
    .novel-card .card-title {
      font-size: 14px; font-weight: 600; color: #333;
      margin: 0 0 6px; line-height: 1.4;
      overflow: hidden; text-overflow: ellipsis; display: -webkit-box;
      -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    }
    .novel-card .card-author {
      font-size: 12px; color: #888; margin: 0;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .novel-card .card-author::before { content: "作者: "; }

    .pager {
      display: flex; justify-content: center; align-items: center; gap: 8px;
      padding: 24px 32px 48px; font-size: 14px;
    }
    .pager a, .pager .current {
      padding: 8px 14px; border-radius: 6px; text-decoration: none;
      background: #fff; color: #555; border: 1px solid #ddd; transition: all .2s;
    }
    .pager a:hover { background: #3498db; color: #fff; border-color: #3498db; }
    .pager .current { background: #3498db; color: #fff; border-color: #3498db; font-weight: 600; }
    .pager .disabled { opacity: .4; pointer-events: none; }
    .empty { text-align: center; padding: 60px 20px; color: #999; }
  </style>
</head>
<body>
  <div class="gallery-header">
    <h1>📚 小说书库</h1>
    <nav class="main-nav">
      <a href="/" class="nav-link">🏠 首页</a>
      <a href="/novels" class="nav-link active">小说书库</a>
      <a href="/admin" class="nav-link">⚙️ 后台</a>
    </nav>
  </div>

  <div class="crawl-bar">
    <input type="text" id="searchInput" placeholder="搜索书名或作者..." value="<%= keyword %>">
    <button onclick="doSearch()">搜索</button>
    <button onclick="crawlHome()" id="crawlBtn">爬取首页</button>
    <span class="crawl-msg" id="crawlMsg"></span>
  </div>

  <% if (novels.length === 0) { %>
    <div class="empty">
      <p style="font-size:48px;margin:0;">📚</p>
      <p style="margin:10px 0 0;">暂无小说，点击「爬取首页」开始抓取</p>
    </div>
  <% } else { %>
    <div class="novel-grid">
      <% novels.forEach(novel => { %>
        <a href="/novel/<%= novel.id %>" class="novel-card">
          <div class="cover-wrap">
            <% if (novel.cover) { %>
              <img src="<%= novel.cover %>" alt="<%= novel.title %>" loading="lazy">
            <% } else { %>
              <div class="no-cover"><%= novel.title %></div>
            <% } %>
            <% if (novel.status) { %>
              <span class="status-badge"><%= novel.status %></span>
            <% } %>
            <% if (novel.category) { %>
              <span class="category-badge"><%= novel.category %></span>
            <% } %>
          </div>
          <div class="card-info">
            <h3 class="card-title"><%= novel.title %></h3>
            <p class="card-author"><%= novel.author %></p>
          </div>
        </a>
      <% }); %>
    </div>

    <% if (totalPages > 1) { %>
      <div class="pager">
        <% if (page > 1) { %>
          <a href="?page=<%= page - 1 %><%= keyword ? '&q=' + encodeURIComponent(keyword) : '' %>">‹ 上一页</a>
        <% } else { %>
          <span class="disabled">‹ 上一页</span>
        <% } %>

        <span class="current"><%= page %> / <%= totalPages %></span>
        <span style="color:#999;font-size:13px;">(共 <%= total %> 本)</span>

        <% if (page < totalPages) { %>
          <a href="?page=<%= page + 1 %><%= keyword ? '&q=' + encodeURIComponent(keyword) : '' %>">下一页 ›</a>
        <% } else { %>
          <span class="disabled">下一页 ›</span>
        <% } %>
      </div>
    <% } %>
  <% } %>

  <script>
    function doSearch() {
      const keyword = document.getElementById('searchInput').value.trim();
      window.location.href = '/novels?q=' + encodeURIComponent(keyword);
    }

    document.getElementById('searchInput').addEventListener('keypress', (e) => {
      if (e.key === 'Enter') doSearch();
    });

    async function crawlHome() {
      const btn = document.getElementById('crawlBtn');
      const msg = document.getElementById('crawlMsg');
      btn.disabled = true;
      msg.textContent = '爬取中...';

      try {
        const res = await fetch('/api/novel/crawl-home', { method: 'POST' });
        const data = await res.json();

        if (data.success) {
          msg.textContent = data.message;
          setTimeout(() => window.location.reload(), 1500);
        } else {
          msg.textContent = '失败: ' + data.message;
          btn.disabled = false;
        }
      } catch (err) {
        msg.textContent = '请求失败: ' + err.message;
        btn.disabled = false;
      }
    }
  </script>
</body>
</html>
