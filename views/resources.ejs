<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1>🎯 媒体资源爬虫管理系统</h1>
    <nav>
      <a href="/">首页</a>
      <a href="/resources" class="active">资源列表</a>
    </nav>
  </header>

  <main class="container">
    <section class="resources-section">
      <div class="section-header">
        <h2>资源列表</h2>
        <button class="btn btn-secondary" onclick="location.reload()">刷新</button>
      </div>

      <% if (resources && resources.length > 0) { %>
        <div class="resources-grid">
          <% resources.forEach(resource => { %>
            <div class="resource-card" data-status="<%= resource.status %>">
              <div class="resource-header">
                <span class="type-badge <%= resource.type %>">
                  <%= resource.type === 'image' ? '🖼️' : resource.type === 'video' ? '🎬' : '🎵' %>
                  <%= resource.type %>
                </span>
                <span class="status-badge <%= resource.status %>">
                  <%= resource.status %>
                </span>
              </div>

              <div class="resource-body">
                <h3><%= resource.title || '处理中...' %></h3>
                <p class="url"><%= resource.url %></p>

                <% if (resource.file_path) { %>
                  <div class="resource-info">
                    <p><strong>文件:</strong> <%= resource.file_path %></p>
                    <p><strong>大小:</strong> <%= (resource.file_size / 1024).toFixed(2) %> KB</p>
                  </div>
                  <a href="/<%= resource.file_path %>" class="btn btn-download" download>下载</a>
                <% } %>
              </div>

              <div class="resource-footer">
                <small>创建时间: <%= new Date(resource.created_at).toLocaleString('zh-CN') %></small>
                <button class="btn btn-delete" onclick="deleteResource(<%= resource.id %>)">删除</button>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <p>暂无资源</p>
          <a href="/" class="btn btn-primary">添加第一个任务</a>
        </div>
      <% } %>
    </section>
  </main>

  <footer>
    <p>&copy; 2024 媒体资源爬虫系统 | 仅用于合法用途</p>
  </footer>

  <script src="/js/resources.js"></script>
</body>
</html>
