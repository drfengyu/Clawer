PORT=3000
DOWNLOAD_PATH=./downloads
DB_PATH=./database.db

# 站点对外基址（RSS item link / 邮件正文用，无则按请求自动推断）
PUBLIC_BASE_URL=http://localhost:3000

# 推送总开关：true 时调度器每日爬完后推送"今日新增"动漫
PUSH_ENABLED=false

# Bark（iOS）：填 key 即启用；BARK_SERVER 默认官方服务器
BARK_KEY=
BARK_SERVER=https://api.day.app

# Server酱（微信）：填 SendKey 即启用（SCTxxx 走 sctapi.ftqq.com）
SERVERCHAN_KEY=

# 邮件 SMTP：默认网易 163 邮箱，填好 USER/PASS(授权码)/MAIL_TO 即启用
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
